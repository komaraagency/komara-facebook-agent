# Komara Facebook Agent - Variables d'environnement
# Copie en .env et remplis les valeurs

# Page Facebook ID (N-dine K fans)
FACEBOOK_PAGE_ID=105344997852517

# Token d'accès Page (Meta Business / Graph API Explorer)
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token

# Token de vérification webhook (choisis une phrase secrète)
FACEBOOK_VERIFY_TOKEN=komara_verify_secret

# Mode simulation (true = n'envoie rien à Facebook, false = live)
DRY_RUN=true

# Version Graph API
GRAPH_API_VERSION=v23.0

# Port
PORT=8000
